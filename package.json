{
  "name": "poker-flopsolve",
  "version": "0.4.1",
  "description": "Postflop Texas Hold'em solver — give it a board, two ranges and a betting scheme, and it solves to showdown.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarraghGeo/poker-flopsolve.git"
  },
  "homepage": "https://github.com/DarraghGeo/poker-flopsolve#readme",
  "bugs": {
    "url": "https://github.com/DarraghGeo/poker-flopsolve/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    },
    "./threads": {
      "types": "./dist/threads.d.ts",
      "browser": "./dist/browser-threads.js",
      "import": "./dist/threads.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "solve": "node --import tsx bin/solve.ts",
    "ui": "node --import tsx ui/server.ts",
    "bench": "node --import tsx bin/bench.ts",
    "bench:kernels": "node --import tsx bin/kernels.ts",
    "bench:browser": "node --import tsx bin/bench-browser.ts",
    "bench:browser:threads": "node --import tsx bin/bench-browser-threads.ts",
    "bench:gpu": "node --import tsx bin/bench-gpu.ts",
    "build:wasm": "node --import tsx scripts/build-wasm.ts",
    "prepublishOnly": "npm run build",
    "bench:compare": "node --import tsx bench/compare/run.ts"
  },
  "keywords": [
    "poker",
    "holdem",
    "gto",
    "cfr",
    "solver",
    "postflop"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "assemblyscript": "^0.28.20",
    "esbuild": "^0.27.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "browser": {
    "./dist/index.js": "./dist/browser.js",
    "./dist/threads.js": "./dist/browser-threads.js"
  }
}
